# GTA Clipper — slice 2 credentials. Copy to `.env` and fill in YOUR values.
# `.env` is git-ignored. NEVER commit it, never paste values into code,
# chat, or a screenshot. See SETUP.md for how to get each value.
#
# Dry-run is the default: with no credentials at all, `python3 post.py`
# still works and only writes dry-run receipts. A real post needs the
# platform's block below AND --live (CLI) / dry-run off (dashboard).

# --- general ---
# DRY_RUN=1                 # optional; dry-run is already the default

# --- YouTube (Data API v3) ---
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=    # from: python3 posters/youtube_oauth.py
# YOUTUBE_PRIVACY=private   # private (default) | unlisted | public (only after Google's audit)

# --- TikTok (Content Posting API, Direct Post) ---
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_ACCESS_TOKEN=      # user token for your TikTok creator account (2h life)
# TIKTOK_REFRESH_TOKEN=     # optional; refreshes the access token (180d life)
# TIKTOK_PRIVACY=SELF_ONLY  # SELF_ONLY (default) | PUBLIC_TO_EVERYONE (only after TikTok's audit)

# --- Instagram + Facebook (Meta Graph API v26.0, Facebook Login path) ---
# Use a SEPARATE personal Meta app for these clips — NOT the Rivryn
# platform app (that one is for HHS client workspaces). See SETUP.md.
# META_APP_ID=
# INSTAGRAM_USER_ID=        # numeric IG user id of the Professional (Business/Creator) account
# META_PAGE_ACCESS_TOKEN=   # long-lived Page token (instagram_content_publish + pages_manage_posts)
# FACEBOOK_PAGE_ID=         # numeric id of the Facebook Page the Reel goes to
# FACEBOOK_PAGE_ACCESS_TOKEN=  # optional: defaults to META_PAGE_ACCESS_TOKEN if unset
# META_GRAPH_VERSION=v26.0  # optional override
