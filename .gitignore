# Footage and outputs — never commit video
input/
output/
jobs/
*.mp4
*.mkv
*.mov
*.webm
*.wav
*.srt
!**/README.md

# Exported client review folders (contain full-size clip mp4s) — never commit
review/*
!review/demo/

# Python venv + models (downloaded locally, never commit)
venv/
__pycache__/
*.pyc
models/
~/.cache/huggingface/

# Secrets — never commit keys of any kind
.env
.env.*
!.env.example
*.key
*.pem
*token*.json
credentials*.json
# Accounts + session secret — password hashes and the signing key
accounts.json
.session-secret
